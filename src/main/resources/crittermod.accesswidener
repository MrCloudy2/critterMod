# isCurrentlyGlowing() reads that shared flag rather than hasGlowingTag(). Setting it
# is therefore the only way to make vanilla outline an entity from the client side.
accessible	method	net/minecraft/world/entity/Entity	setSharedFlag	(IZ)V
